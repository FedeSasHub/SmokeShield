<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SmokeShield" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:statusBarColor">@color/primaryColor</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>

        <item name="android:colorBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="colorError">@color/colorSos</item>

        <item name="android:textColorPrimary">@color/textColor</item>
        <item name="android:textColorSecondary">@color/textColorLight</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SmokeShield.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SmokeShield.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SmokeShield.Large</item>
    </style>

    <style name="ShapeAppearance.SmokeShield.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.SmokeShield.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.SmokeShield.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Theme.SmokeShield" parent="Base.Theme.SmokeShield" />
</resources>